{
 "info": {
  "name": "Tienda APF2",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Pruebas del APF2: seguridad JWT, CRUD, JPQL y transacciones. Ejecutar primero 'Login admin'."
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://localhost:8080"
  },
  {
   "key": "token",
   "value": ""
  },
  {
   "key": "tokenUser",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "1. Auth",
   "item": [
    {
     "name": "Sin token (espera 401)",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/productos",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos"
       ]
      },
      "auth": {
       "type": "noauth"
      }
     }
    },
    {
     "name": "Login admin",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/auth/login",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "login"
       ]
      },
      "auth": {
       "type": "noauth"
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
         "pm.collectionVariables.set(\"token\", pm.response.json().token);"
        ]
       }
      }
     ]
    },
    {
     "name": "Login user",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/auth/login",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "login"
       ]
      },
      "auth": {
       "type": "noauth"
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
         "pm.collectionVariables.set(\"tokenUser\", pm.response.json().token);"
        ]
       }
      }
     ]
    },
    {
     "name": "Con token (espera 200)",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/productos",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    }
   ]
  },
  {
   "name": "2. CRUD productos",
   "item": [
    {
     "name": "Crear producto (201)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/productos",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"nombre\": \"Teclado\",\n  \"precio\": 120.5,\n  \"stock\": 20,\n  \"categoria\": {\n    \"id\": 1\n  }\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     }
    },
    {
     "name": "Obtener producto 1 (200)",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/productos/1",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos",
        "1"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    },
    {
     "name": "Actualizar producto 1 (200)",
     "request": {
      "method": "PUT",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/productos/1",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos",
        "1"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"nombre\": \"Laptop Gamer\",\n  \"precio\": 3200.0,\n  \"stock\": 10,\n  \"categoria\": {\n    \"id\": 1\n  }\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     }
    },
    {
     "name": "Eliminar producto 3 con admin (204)",
     "request": {
      "method": "DELETE",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/productos/3",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos",
        "3"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    },
    {
     "name": "Eliminar producto 2 con user (403)",
     "request": {
      "method": "DELETE",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/productos/2",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos",
        "2"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{tokenUser}}",
         "type": "string"
        }
       ]
      }
     }
    }
   ]
  },
  {
   "name": "3. Consultas JPQL",
   "item": [
    {
     "name": "Buscar por nombre",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/productos/buscar?texto=lap",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos",
        "buscar"
       ],
       "query": [
        {
         "key": "texto",
         "value": "lap"
        }
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    },
    {
     "name": "Por categoría",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/productos/categoria/1",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos",
        "categoria",
        "1"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    },
    {
     "name": "Stock bajo",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/productos/stock-bajo?minimo=10",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos",
        "stock-bajo"
       ],
       "query": [
        {
         "key": "minimo",
         "value": "10"
        }
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    },
    {
     "name": "Valor del inventario",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/productos/valor-inventario",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productos",
        "valor-inventario"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    }
   ]
  },
  {
   "name": "4. Transacciones",
   "item": [
    {
     "name": "Venta exitosa (201)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/ventas",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "ventas"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"productoId\": 1,\n  \"cantidad\": 2\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     }
    },
    {
     "name": "Rollback: stock insuficiente (400)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/ventas",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "ventas"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"productoId\": 2,\n  \"cantidad\": 999\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     }
    }
   ]
  }
 ]
}